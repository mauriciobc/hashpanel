# Mastodon API Configuration
MASTODON_URL=https://ursal.zone/api/v1/
CLIENT_KEY=your_client_key_here
CLIENT_SECRET=your_client_secret_here
ACCESS_TOKEN=your_access_token_here

# Server Configuration
PORT=3000
HOST=0.0.0.0
SERVER_PUBLIC_URL=http://localhost:3000
NODE_ENV=development

# Optional: Preferred Timezone (Default: America/Sao_Paulo)
PREFERRED_TIMEZONE=America/Sao_Paulo

# Optional: Trust Proxy (Number of proxies or 'false')
TRUST_PROXY=1

# Optional: CORS Origin (Comma-separated list)
CORS_ORIGIN=http://localhost:3000

# Telemetry Configuration (Optional)
# Telemetry is OFF by default. Set TELEMETRY_ENDPOINT to opt in to sending
# anonymous usage events (e.g. server startup) to your own collector.
# TELEMETRY_ENDPOINT=https://your-telemetry-server.com/ingest/your-token
# DISABLE_TELEMETRY=true   # force-disable even if TELEMETRY_ENDPOINT is set
