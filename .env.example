# ============================================
# Configuração do HashPanel
# ============================================
# Copie este arquivo para `.env` e preencha os valores.
# A URL do Mastodon pode ser a raiz da instância ou incluir /api/v1 —
# o HashPanel normaliza para a raiz.

# --- Mastodon (obrigatório) ---
MASTODON_URL=https://ursal.zone
CLIENT_KEY=your_client_key_here
CLIENT_SECRET=your_client_secret_here
ACCESS_TOKEN=your_access_token_here

# --- Servidor ---
PORT=3000
HOST=0.0.0.0
SERVER_PUBLIC_URL=http://localhost:3000
NODE_ENV=production
LOG_LEVEL=info

# Fuso horário usado para decidir o dia da hashtag e formatar as datas
PREFERRED_TIMEZONE=America/Sao_Paulo

# Origem do CORS (obrigatório em produção).
# Várias origens: https://a.com,https://b.com
CORS_ORIGIN=https://seudominio.com

# Quantos proxies reversos ficam entre o cliente e a aplicação
# (Caddy/nginx). Use "false" sem proxy reverso.
TRUST_PROXY=0

# Redes (CIDR) dos proxies reversos confiáveis. Só uma conexão vinda
# daqui tem o X-Forwarded-For lido — o header é controlado pelo cliente,
# e sem essa lista cada requisição cairia num limite diferente.
# Com o Caddy do compose do Portainer: TRUSTED_PROXY_IPS=172.16.0.0/12
TRUSTED_PROXY_IPS=

# --- Desempenho ---
API_TIMEOUT_MS=30000
RATE_LIMIT_DELAY_MS=1000
MAX_API_PAGES=20
TOOTS_PER_PAGE=40

# --- Cache ---
CACHE_TTL_SECONDS=300
ENABLE_CACHE=true

# --- Banco de dados ---
# Caminho do arquivo SQLite (padrão: ./data/hashpanel.db)
# DB_PATH=/app/data/hashpanel.db

# --- Proxy de imagens ---
# Domínios liberados para o proxy de mídia (separados por vírgula).
# MEDIA_PROXY_ALLOWLIST=cdn.ursal.zone,i.cdn.ursal.zone
MEDIA_PROXY_CACHE_MAX_MB=50
MEDIA_PROXY_CACHE_MAX_ENTRIES=200

# --- Health check ---
HEALTHCHECK_TIMEOUT_MS=2500

# --- Cron ---
# Quando a coleta diária roda (formato do cron).
CRON_SCHEDULE=0 2 * * *
