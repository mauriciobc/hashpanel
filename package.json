{
  "name": "hashbot2",
  "version": "1.0.0",
  "description": "Sistema para monitorar hashtags diárias no Mastodon, coletar dados históricos e fornecer dashboard web",
  "type": "module",
  "main": "src/server/main.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node src/server/main.js",
    "server": "node src/server/main.js",
    "cli": "node cli.js",
    "report": "node cli.js report",
    "dev": "npm run dev:watch",
    "dev:server": "nodemon src/server/main.js",
    "dev:cli": "nodemon cli.js",
    "dev:watch": "nodemon --watch src --exec \"node src/server/main.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "clean": "rm -rf logs node_modules/.cache",
    "logs": "tail -f logs/combined.log",
    "status": "node cli.js status",
    "analyze": "node cli.js analyze",
    "collect:history": "node src/cli/collectHistory.js",
    "collect:history:7days": "node src/cli/collectHistory.js --last-7-days",
    "db:migrate": "node -e \"import('./src/database/index.js').then(m => m.getDatabase().migrate())\"",
    "db:clear": "node scripts/clear-database.js",
    "test:weekly": "node scripts/test-weekly-history.js",
    "test:weekly:create-data": "node scripts/create-test-data.js",
    "diagnose:collection": "node scripts/diagnose-collection.js",
    "cron:setup": "sh scripts/setup-cron.sh",
    "cron:test": "sh scripts/cron-collect-history.sh"
  },
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "canvas": "^3.2.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "mastodon-api": "^1.3.0",
    "moment-timezone": "^0.5.47",
    "node-cache": "^5.1.2",
    "winston": "^3.19.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "mastodon",
    "hashtags",
    "dashboard",
    "analytics",
    "social-media",
    "nodejs",
    "express"
  ],
  "author": "",
  "license": "ISC"
}
